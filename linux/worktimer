class App:
    def __init__(self):
        self.core = Core()
        self.update_busy = False
        self.pending_update = None
        self.closing = False
        self.window = MainWindow(self)
        self.widget = None
        self.ind = None
        self.menu = None
        self.build_tray()
        if self.core.settings.get("widget", "1") != "0":
            self.toggle_widget()
        GLib.timeout_add(1000, self.tick)
        GLib.idle_add(self.startup_update)
        GLib.timeout_add_seconds(3600, self.auto_update)

    # ---- трей ----
    def build_tray(self):
        self.menu = Gtk.Menu()
        self.mi_toggle = Gtk.MenuItem(label="Старт")
        self.mi_toggle.connect("activate", lambda *_: (self.core.toggle(), self.refresh()))
        self.menu.append(self.mi_toggle)
        self.mi_stop = Gtk.MenuItem(label="Стоп — завершить сессию")
        self.mi_stop.connect("activate", lambda *_: (self.core.stop(), self.refresh()))
        self.menu.append(self.mi_stop)
        mi_projects = Gtk.MenuItem(label="Работы: старт / пауза")
        self.project_menu = Gtk.Menu()
        mi_projects.set_submenu(self.project_menu)
