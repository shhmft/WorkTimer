    def export_dialog(self):
        d = Gtk.Dialog(title="Экспорт за период", transient_for=self.window, modal=True)
        d.add_buttons("Отмена", Gtk.ResponseType.CANCEL, "Экспорт", Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)
        box.add(Gtk.Label(label="Начало периода"))
        c1 = Gtk.Calendar()
        box.add(c1)
        box.add(Gtk.Label(label="Конец периода"))
        c2 = Gtk.Calendar()
        box.add(c2)
        today = dt.date.today()
        first = today.replace(day=1)
        for c, day in ((c1, first), (c2, today)):
            c.select_month(day.month - 1, day.year)
            c.select_day(day.day)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            y1, m1, d1 = c1.get_date()
            y2, m2, d2 = c2.get_date()
            a, b = dt.date(y1, m1 + 1, d1), dt.date(y2, m2 + 1, d2)
            if a > b:
                a, b = b, a
            d.destroy()
            self.do_export(a, b)
        else:
            d.destroy()

    def do_export(self, a, b):
        ch = Gtk.FileChooserDialog(title="Сохранить CSV", transient_for=self.window,
                                   action=Gtk.FileChooserAction.SAVE)
        ch.add_buttons("Отмена", Gtk.ResponseType.CANCEL, "Сохранить", Gtk.ResponseType.OK)
        safe_name = "".join("_" if c in '/\\<>:"|?*' else c for c in self.core.current.name)
        ch.set_current_name("%s_worktime_%s_%s.csv" % (safe_name, a.isoformat(), b.isoformat()))
        ch.set_do_overwrite_confirmation(True)
        if ch.run() == Gtk.ResponseType.OK:
            path = ch.get_filename()
            ch.destroy()
            with open(path, "w", encoding="utf-8", newline="") as f:
                f.write(self.core.export_csv(a, b))
        else:
            ch.destroy()

    def quit(self):
        self.closing = True
        self.core.pause_all()
        Gtk.main_quit()


def parse_hours(s):
    s = s.strip().replace(",", ".")
    if not s:
        return None
    try:
        if s.lower().endswith("m"):
            return float(s[:-1])
        if ":" in s:
            h, m = s.split(":", 1)
            return int(h) * 60 + int(m)
        return float(s) * 60
    except ValueError:
        return None


def main():
    if "--version" in sys.argv:
        print("WorkTimer " + VERSION)
        return 0

    if "--toggle" in sys.argv:
        if signal_instance(signal.SIGUSR1):
            return 0
        print("WorkTimer не запущен", file=sys.stderr)
        return 1

    instance_fd = acquire_instance()
    if instance_fd is None:
        signal_instance(signal.SIGUSR2)
        return 0

    try:
        app = App()
        if "--hidden" not in sys.argv:
            app.show_window()

        def on_toggle():
            app.core.toggle()
            app.refresh()
            return True

        def on_show():
            app.show_window()
            return True

        def on_sigterm():
            app.quit()
            return False

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_toggle)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, on_show)
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, on_sigterm)
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, on_sigterm)

        Gtk.main()
        return 0
    finally:
        os.close(instance_fd)


if __name__ == "__main__":
    sys.exit(main())
