    def edit_day(self, day):
        raw = self.core.raw_map().get(day, 0.0)
        cur = self.core.day_map().get(day, 0.0)
        d = Gtk.Dialog(title="Часы за " + day.strftime("%d.%m.%Y"),
                       transient_for=self.window, modal=True)
        d.add_buttons("Отмена", Gtk.ResponseType.CANCEL, "Сохранить", Gtk.ResponseType.OK)
        box = d.get_content_area()
        box.set_spacing(8)
        box.set_border_width(12)
        hint = ("Отсчитано таймером: %s — дальнейший учёт добавится сверху."
                % fmt(raw)) if raw > 0 else "Пустое поле — убрать правку."
        box.add(Gtk.Label(label="Формат: 7:30, 7.5 или 450m"))
        box.add(Gtk.Label(label=hint))
        entry = Gtk.Entry(text=fmt(cur))
        box.add(entry)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            s = entry.get_text().strip()
            if not s:
                self.core.adjust.pop(day, None)
            else:
                mins = parse_hours(s)
                if mins is None:
                    self.error("Не понял формат. Примеры: 7:30, 7.5, 450m")
                else:
                    delta = mins - raw
                    if abs(delta) < 0.01:
                        self.core.adjust.pop(day, None)
                    else:
                        self.core.adjust[day] = delta
            self.core.save()
            self.refresh()
        d.destroy()

    def error(self, msg, warning=True):
        m = Gtk.MessageDialog(transient_for=self.window, modal=True,
                              message_type=Gtk.MessageType.WARNING if warning else Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.OK, text=msg)
        m.run()
        m.destroy()

