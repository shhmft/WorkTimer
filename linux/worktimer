def instance_path():
    return os.path.join(data_dir(), ".instance.lock")


def acquire_instance():
    """Держим блокировку всё время работы GTK, чтобы данные писал один процесс."""
    import fcntl
    fd = os.open(instance_path(), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode("ascii"))
    return fd


def signal_instance(signum):
    """Посылаем команду только процессу, который держит блокировку."""
    import fcntl
    try:
        fd = os.open(instance_path(), os.O_RDWR)
    except FileNotFoundError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            return False
        os.lseek(fd, 0, os.SEEK_SET)
        try:
            pid = int(os.read(fd, 32).decode("ascii"))
        except ValueError:
            return False
        if pid <= 0:
            return False
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            return False
        return True
    finally:
        os.close(fd)

last_error = [None]


def log_error(what, exc):
    last_error[0] = "%s: %s" % (what, exc)
    try:
        with open(ERRLOG(), "a", encoding="utf-8") as f:
            f.write("%s  %s\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                                  last_error[0]))
    except Exception:
        pass


def write_atomic(path, text):
    """Пишем во временный файл и подменяем — как в windows-версии."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    if not os.path.exists(path) or (os.path.getsize(path) == 0 and text):
        raise IOError("файл %s не записался" % path)


def load_segments():
    out = []
    if not os.path.exists(SESSIONS()):
        return out
    try:
        with open(SESSIONS(), encoding="utf-8-sig") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                p = line.split("|")
                if len(p) < 2:
                    continue
                try:
                    # Files from Windows may include a UTC offset; the ledger uses local wall time.
                    a = dt.datetime.fromisoformat(p[0]).replace(tzinfo=None)
                    b = dt.datetime.fromisoformat(p[1]).replace(tzinfo=None)
                except ValueError:
                    continue
                if b > a:
                    out.append((a, b, p[2] if len(p) > 2 and p[2] else "default"))
    except Exception as e:
        log_error("чтение sessions.csv", e)
    return out


def save_segments(segs):
    write_atomic(SESSIONS(), "".join(
        "%s|%s|%s\n" % (a.isoformat(), b.isoformat(), pid)
        for a, b, pid in (segment_parts(s) for s in segs)))


def segment_parts(segment):
    return tuple(segment) if len(segment) == 3 else (*segment, "default")


def load_adjust():
    out = {}
    if not os.path.exists(ADJUST()):
        return out
    try:
        with open(ADJUST(), encoding="utf-8-sig") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                p = line.split("|")
                if len(p) < 2:
                    continue
                try:
                    pid = p[2] if len(p) > 2 and p[2] else "default"
                    out.setdefault(pid, {})[dt.date.fromisoformat(p[0])] = float(p[1])
                except ValueError:
                    continue
    except Exception as e:
        log_error("чтение adjustments.csv", e)
    return out


def save_adjust(projects):
    body = "# дата|поправка в минутах|работа\n"
    body += "".join("%s|%s|%s\n" % (d.isoformat(), v, p.id)
                    for p in projects for d, v in sorted(p.adjust.items()))
    write_atomic(ADJUST(), body)


class WorkProject:
    def __init__(self, pid, name):
        self.id, self.name = pid, name
        self.run_start = None
        self.session_accum = 0.0
        self.adjust = {}


def load_projects():
    projects = {"default": WorkProject("default", "Общая работа")}
    if os.path.exists(PROJECTS()):
        with open(PROJECTS(), encoding="utf-8-sig") as f:
            for line in f:
                fields = line.strip().split("|")
                if len(fields) != 2 or not fields[0]:
                    continue
                try:
                    name = base64.b64decode(fields[1], validate=True).decode("utf-8")
                    projects[fields[0]] = WorkProject(fields[0], name)
                except (ValueError, UnicodeError) as exc:
                    log_error("чтение названия работы", exc)
    return projects


def save_projects(projects):
    write_atomic(PROJECTS(), "".join("%s|%s\n" %
        (p.id, base64.b64encode(p.name.encode("utf-8")).decode("ascii")) for p in projects))


def load_settings():
    out = {}
    if os.path.exists(SETTINGS()):
        try:
            with open(SETTINGS(), encoding="utf-8") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.split("=", 1)
                        out[k.strip()] = v.strip()
        except Exception as e:
            log_error("чтение settings.ini", e)
    return out


def save_settings(s):
    try:
        write_atomic(SETTINGS(), "".join("%s=%s\n" % (k, v) for k, v in s.items()))
    except Exception as e:
        log_error("запись settings.ini", e)


def fmt(minutes):
    if minutes < 0:
        minutes = 0
    t = int(round(minutes))
    return "%d:%02d" % (t // 60, t % 60)


# ---------------------------------------------------------------- рисование
def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def text(cr, s, x, y, size, color, bold=False, align="left", width=None, ellipsis=False):
    layout = PangoCairo.create_layout(cr)
    desc = Pango.FontDescription("Sans %s%d" % ("Bold " if bold else "", size))
    layout.set_font_description(desc)
    layout.set_text(s, -1)
    if ellipsis and width is not None:
        layout.set_width(int(width * Pango.SCALE))
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        layout.set_single_paragraph_mode(True)
    tw, th = layout.get_pixel_size()
    if align == "right" and width is not None:
        x = x + width - tw
    elif align == "center" and width is not None:
        x = x + (width - tw) / 2
    cr.set_source_rgb(*color)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return tw, th


def grad(cr, x, y, w, h, c1, c2, horizontal=True):
    import cairo
    g = cairo.LinearGradient(x, y, x + w if horizontal else x,
                             y if horizontal else y + h)
    g.add_color_stop_rgb(0, *c1)
    g.add_color_stop_rgb(1, *c2)
    cr.set_source(g)


# ---------------------------------------------------------------- ядро
class Core:
    def __init__(self):
        self.segments = load_segments()
        projects = load_projects()
        adjustments = load_adjust()
        ids = {segment_parts(s)[2] for s in self.segments} | set(adjustments)
        for pid in ids:
            if pid not in projects:
                projects[pid] = WorkProject(pid, "Восстановленная работа")
        self.projects = list(projects.values())
        for p in self.projects:
            p.adjust = adjustments.get(p.id, {})
        self.settings = load_settings()
        self.current = projects.get(self.settings.get("project"), self.projects[0])
        if "--updated" in sys.argv:
            resume = self.settings.pop("updateResume", "").split(",")
            for p in self.projects:
                if p.id in resume:
                    p.run_start = dt.datetime.now()
            save_settings(self.settings)
        self.save_broken = False
        self.last_save = dt.datetime.now()

    # --- состояние ---
    @property
    def adjust(self):
        return self.current.adjust

    @adjust.setter
    def adjust(self, value):
        self.current.adjust = value

    @property
    def run_start(self):
        return self.current.run_start

    @run_start.setter
    def run_start(self, value):
        self.current.run_start = value

    @property
    def session_accum(self):
        return self.current.session_accum

    @session_accum.setter
    def session_accum(self, value):
        self.current.session_accum = value

    @property
    def running(self):
        return self.run_start is not None

    @property
    def running_count(self):
        return sum(p.run_start is not None for p in self.projects)

    @property
    def any_running(self):
        return self.running_count > 0

    @property
    def widget_caption(self):
        active = [p.name for p in self.projects if p.run_start is not None]
        return ", ".join(active) if active else self.current.name

    def select(self, project):
        self.current = project
        self.settings["project"] = project.id
        save_settings(self.settings)

    def validate_name(self, name, except_project=None):
        name = name.strip()
        if not name or len(name) > 100 or any(c in name for c in "\r\n\t"):
            raise ValueError("Введите название от 1 до 100 символов в одну строку.")
        if any(p is not except_project and p.name.casefold() == name.casefold() for p in self.projects):
            raise ValueError("Работа с таким названием уже есть.")
        return name

    def add_project(self, name):
        project = WorkProject(uuid.uuid4().hex, self.validate_name(name))
        self.projects.append(project)
        self.save()
        self.select(project)
        return project

    def rename_project(self, name):
        self.current.name = self.validate_name(name, self.current)
        self.save()

    def delete_project(self, project):
        if len(self.projects) <= 1:
            raise ValueError("Нельзя удалить последнюю работу.")
        if project.run_start is not None:
            self.close_segment(project)
        self.segments = [s for s in self.segments if segment_parts(s)[2] != project.id]
        self.projects.remove(project)
        project.adjust.clear()
        if self.current is project:
            self.current = self.projects[0]
            self.settings["project"] = self.current.id
        self.save()

    def toggle(self, project=None):
        project = project or self.current
        if project.run_start is not None:
            self.close_segment(project)
        else:
            project.run_start = dt.datetime.now()
        self.save()

    def stop(self):
        if self.running:
            self.close_segment()
        self.session_accum = 0.0
        self.save()

    def close_segment(self, project=None, now=None):
        project = project or self.current
        if project.run_start is None:
            return
        now = now or dt.datetime.now()
        if now > project.run_start:
            self.segments.append((project.run_start, now, project.id))
            project.session_accum += (now - project.run_start).total_seconds() / 60.0
        project.run_start = None

    def pause_all(self):
        now = dt.datetime.now()
        for p in self.projects:
            self.close_segment(p, now)
        self.save()

    # --- подсчёт ---
    def raw_map(self, project=None, now=None):
        project = project or self.current
        now = now or dt.datetime.now()
        m = {}
        for segment in self.segments:
            a, b, pid = segment_parts(segment)
            if pid == project.id:
                self._span(m, a, b)
        if project.run_start is not None:
            self._span(m, project.run_start, now)
        return m

    @staticmethod
    def _span(m, a, b):
        while a < b:
            day_end = dt.datetime.combine(a.date() + dt.timedelta(days=1), dt.time())
            chunk = min(b, day_end)
            m[a.date()] = m.get(a.date(), 0.0) + (chunk - a).total_seconds() / 60.0
            a = chunk

    def day_map(self, project=None, now=None):
        project = project or self.current
        m = self.raw_map(project, now)
        for d, delta in project.adjust.items():
            m[d] = max(0.0, m.get(d, 0.0) + delta)
        return m

    def today(self):
        return self.day_map().get(dt.date.today(), 0.0)

    def session(self):
        s = self.session_accum
        if self.running:
            s += (dt.datetime.now() - self.run_start).total_seconds() / 60.0
        return s

    # --- запись ---
    def save(self):
        try:
            segs = list(self.segments)
            now = dt.datetime.now()
            for p in self.projects:
                if p.run_start is not None and now > p.run_start:
                    segs.append((p.run_start, now, p.id))
            save_projects(self.projects)
            save_segments(segs)
            save_adjust(self.projects)
            self.last_save = dt.datetime.now()
            self.save_broken = False
        except Exception as e:
            log_error("сохранение данных", e)
            self.save_broken = True

    def export_csv(self, start, end):
        output = io.StringIO(newline="")
        wr = csv.writer(output, delimiter=";")
        wr.writerow(["Работа", "Дата", "День недели", "Часы (чч:мм)", "Часы (десятичные)"])
        m, total, worked = self.day_map(), 0.0, 0
        day = start
        name = self.current.name
        if name and name[0] in "=+-@":
            name = "'" + name
        while day <= end:
            v = m.get(day, 0.0)
            if v > 0:
                total += v
                worked += 1
                wr.writerow([name, day.strftime("%d.%m.%Y"), RU_DOW[day.weekday()],
                             fmt(v), ("%.2f" % (v / 60.0)).replace(".", ",")])
            day += dt.timedelta(days=1)
        wr.writerow([])
        wr.writerow(["Период", "%s — %s" % (start.strftime("%d.%m.%Y"), end.strftime("%d.%m.%Y")), "", "", ""])
        wr.writerow(["Рабочих дней", worked, "", "", ""])
        wr.writerow(["ИТОГО", "", "", fmt(total), ("%.2f" % (total / 60.0)).replace(".", ",")])
        return output.getvalue()


# ---------------------------------------------------------------- окно
class MainWindow(Gtk.Window):
    def __init__(self, app):
        super().__init__(title="WorkTimer — учёт рабочих часов")
        self.app = app
        self.core = app.core
        self.set_default_size(TOTAL_W, H)
        self.set_size_request(TOTAL_W, H)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(False)
        self.view_month = dt.date.today().replace(day=1)
        self.scroll = 0
        self.project_scroll = 0
        self.hover = None
        self.rows = []

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                             Gdk.EventMask.POINTER_MOTION_MASK |
                             Gdk.EventMask.SCROLL_MASK |
                             Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect("draw", self.on_draw)
        self.area.connect("button-press-event", self.on_click)
        self.area.connect("motion-notify-event", self.on_motion)
        self.area.connect("scroll-event", self.on_scroll)
        self.add(self.area)
        self.connect("delete-event", self.on_close)

    def on_close(self, *_):
        self.hide()
        return True

    # ---- геометрия кнопок: (x, y, w, h, действие) ----
    def buttons(self):
        return [
            (20, 232, 268, 52, "toggle"),
            (298, 232, W - 318, 52, "stop"),
            (MONTH[0] + 14, MONTH[1] + 16, 30, 30, "prev"),
            (MONTH[0] + 48, MONTH[1] + 16, 30, 30, "next"),
            (20, H - 52, 132, 38, "export"),
            (162, H - 52, 128, 38, "widget"),
            (300, H - 52, 166, 38, "hide"),
            (TOTAL_W - 112, 14, 28, 28, "settings"),
            (TOTAL_W - 44, 14, 28, 28, "hide"),
            (W, 106, 250, 38, "add_project"),
            (W, 622, 121, 38, "rename_project"),
            (W + 129, 622, 121, 38, "delete_project"),
        ]

    def on_motion(self, _w, ev):
        hit = None
        for x, y, w, h, name in self.buttons():
            if x <= ev.x <= x + w and y <= ev.y <= y + h:
                hit = name
        idx = None
        lx, ly = MONTH[0] + 8, MONTH[1] + 96
        if lx <= ev.x <= lx + MONTH[2] - 16 and ly <= ev.y <= ly + 240:
            i = int((ev.y - ly + self.scroll) // ROW_H)
            if 0 <= i < len(self.rows):
                idx = i
        if (hit, idx) != self.hover:
            self.hover = (hit, idx)
            self.area.queue_draw()
        return True

    def on_scroll(self, _w, ev):
        if W <= ev.x < W + 250 and 156 <= ev.y < 610:
            maxs = max(0, len(self.core.projects) * 76 - 454)
            if ev.direction == Gdk.ScrollDirection.DOWN:
                self.project_scroll = min(maxs, self.project_scroll + 76)
            elif ev.direction == Gdk.ScrollDirection.UP:
                self.project_scroll = max(0, self.project_scroll - 76)
            self.area.queue_draw()
            return True
        maxs = max(0, len(self.rows) * ROW_H - 240)
        if ev.direction == Gdk.ScrollDirection.DOWN:
            self.scroll = min(maxs, self.scroll + ROW_H * 2)
        elif ev.direction == Gdk.ScrollDirection.UP:
            self.scroll = max(0, self.scroll - ROW_H * 2)
        self.area.queue_draw()
        return True

    def on_click(self, _w, ev):
        if getattr(ev, "button", 1) != 1:
            return False
        if W <= ev.x < W + 250 and 156 <= ev.y < 610:
            if ev.type != Gdk.EventType.BUTTON_PRESS:
                return True
            index = int((ev.y - 156 + self.project_scroll) // 76)
            if 0 <= index < len(self.core.projects):
                project = self.core.projects[index]
                if ev.x >= W + 198:
                    self.core.toggle(project)
                else:
                    self.core.select(project)
                    self.scroll = 0
                self.app.refresh()
            return True
        for x, y, w, h, name in self.buttons():
            if x <= ev.x <= x + w and y <= ev.y <= y + h:
                self.do_action(name)
                return True
        lx, ly = MONTH[0] + 8, MONTH[1] + 96
        if (ev.type == Gdk.EventType._2BUTTON_PRESS and lx <= ev.x <= lx + MONTH[2] - 16
                and ly <= ev.y < ly + 240):
            i = int((ev.y - ly + self.scroll) // ROW_H)
            if 0 <= i < len(self.rows):
                self.app.edit_day(self.rows[i][0])
        return True

    def do_action(self, name):
        if name == "toggle":
            self.core.toggle(); self.app.refresh()
        elif name == "stop":
            self.core.stop(); self.app.refresh()
        elif name == "prev":
            self.view_month = (self.view_month - dt.timedelta(days=1)).replace(day=1)
            self.scroll = 0
        elif name == "next":
            nxt = self.view_month.replace(day=28) + dt.timedelta(days=7)
            self.view_month = nxt.replace(day=1)
            self.scroll = 0
        elif name == "export":
            self.app.export_dialog()
        elif name == "widget":
            self.app.toggle_widget()
        elif name == "hide":
            self.hide()
        elif name == "settings":
            self.app.settings_dialog()
        elif name == "add_project":
            self.app.project_dialog()
        elif name == "rename_project":
            self.app.project_dialog(rename=True)
        elif name == "delete_project":
            self.app.delete_project_dialog()
        self.area.queue_draw()

    # ---- отрисовка ----
    def on_draw(self, _w, cr):
        core = self.core
        running, paused = core.running, (not core.running and core.session_accum > 0)
        cr.set_source_rgb(*BG)
        cr.paint()

        # шапка
        grad(cr, 20, 21, 14, 14, A1, A2)
