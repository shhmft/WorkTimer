    def show_window(self):
        self.window.show_all()
        self.window.present()

    # ---- обновление ----
    def tick(self):
        core = self.core
        if core.any_running and (dt.datetime.now() - core.last_save).total_seconds() >= 15:
            core.save()
        self.refresh()
        return True

    def refresh(self):
        core = self.core
        running, paused = core.running, (not core.running and core.session_accum > 0)
        any_paused = any(p.session_accum > 0 for p in core.projects)
        state = ("Идёт учёт: %d" % core.running_count) if core.any_running else ("Пауза" if any_paused else "Остановлен")
        label = "%s • %s %s" % (state, core.current.name, fmt(core.today()))
        self.mi_toggle.set_label(("Пауза: " if running else
                                 ("Продолжить: " if paused else "Старт: ")) + core.current.name)
        self.mi_stop.set_label("Стоп: " + core.current.name)
        self.mi_pause_all.set_sensitive(core.any_running)
        icon = ("media-playback-start" if core.any_running else
                ("media-playback-pause" if any_paused else "appointment-soon"))
        try:
            if APPIND and hasattr(self.ind, "set_icon_full"):
                self.ind.set_icon_full(icon, label)
                self.ind.set_label(fmt(core.today()), "0:00")
            else:
                self.ind.set_from_icon_name(icon)
                self.ind.set_tooltip_text(label)
        except Exception:
            pass
        if self.window.get_visible():
            self.window.area.queue_draw()
        if self.widget:
            self.widget.queue_draw()

    # ---- виджет ----
    def toggle_widget(self):
        if self.widget:
            self.widget.destroy()
            self.widget = None
            self.core.settings["widget"] = "0"
        else:
            self.widget = Widget(self)
            self.widget.show_all()
            self.core.settings["widget"] = "1"
        save_settings(self.core.settings)
        self.refresh()

    # ---- автозапуск ----
    def autostart_path(self):
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        d = os.path.join(base, "autostart")
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, "worktimer.desktop")

    def autostart_on(self):
        return os.path.exists(self.autostart_path())

    def toggle_autostart(self):
        p = self.autostart_path()
        if self.autostart_on():
            os.remove(p)
        else:
            with open(p, "w", encoding="utf-8") as f:
                f.write("[Desktop Entry]\nType=Application\nName=WorkTimer\n"
                        "Exec=/usr/bin/worktimer\nIcon=worktimer\n"
                        "X-GNOME-Autostart-enabled=true\nTerminal=false\n")

    # ---- диалоги ----
    def toggle_auto_updates(self, item):
        self.core.settings["updates"] = "1" if item.get_active() else "0"
        save_settings(self.core.settings)

    def auto_update(self):
        if self.closing or self.core.settings.get("updates", "1") == "0" or self.update_busy:
            return True
        try:
            last = dt.datetime.fromisoformat(self.core.settings.get("updateCheck", ""))
            age = dt.datetime.utcnow() - last
            due = age.total_seconds() < 0 or age.total_seconds() >= 86400
        except ValueError:
            due = True
        if due:
            self.check_updates(False)
        return True

    def startup_update(self):
        self.auto_update()
        return False

    def update_worker(self, work, done):
        self.update_busy = True
        self.mi_update.set_sensitive(False)

        def finish(result, error):
            if self.closing:
                return False
            self.update_busy = False
            self.mi_update.set_sensitive(True)
            done(result, error)
            return False

        def worker():
            try:
                result = work()
                GLib.idle_add(finish, result, None)
            except Exception as exc:
                log_error("обновление", exc)
                GLib.idle_add(finish, None, exc)
        threading.Thread(target=worker, daemon=True).start()

    def check_updates(self, manual=False):
        if self.update_busy:
            return
        self.core.settings["updateCheck"] = dt.datetime.utcnow().isoformat()
        save_settings(self.core.settings)

        def done(release, error):
            if error:
                if manual:
                    self.error("Не удалось проверить обновления. Проверьте интернет и попробуйте ещё раз.\n" + str(error))
                return
            self.pending_update = release
            self.mi_update.set_label("Обновить до " + release["version"] if release else
                                     "Проверить обновления (" + VERSION + ")")
            if not release:
                return
            if not manual and self.core.settings.get("updates", "1") == "0":
                return
            if manual or self.core.settings.get("updateNotified") != release["version"]:
                self.core.settings["updateNotified"] = release["version"]
                save_settings(self.core.settings)
                self.offer_update()
        self.update_worker(updates.check_release, done)

    def confirm_update(self, message):
        dialog = Gtk.MessageDialog(transient_for=self.window, modal=True,
                                   message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.YES_NO, text=message)
        accepted = dialog.run() == Gtk.ResponseType.YES
        dialog.destroy()
        return accepted

    def offer_update(self):
        if self.update_busy or not self.pending_update:
            return
        release = self.pending_update
        if not self.confirm_update("Доступна версия %s. Скачать обновление?\nЧасы продолжат считаться во время загрузки." % release["version"]):
            return
        self.mi_update.set_label("Скачивается обновление…")

        def done(path, error):
            self.mi_update.set_label("Обновить до " + release["version"])
            if error:
                self.error("Не удалось скачать обновление.\n" + str(error))
                return
            self.install_update(path, release)
        self.update_worker(lambda: updates.download(release, os.path.join(data_dir(), "updates")), done)

    def install_update(self, path, release):
        try:
            package = subprocess.check_output(["dpkg-deb", "-f", path, "Package"], text=True).strip()
            version = subprocess.check_output(["dpkg-deb", "-f", path, "Version"], text=True).strip()
            if package != "worktimer" or version != release["version"]:
                raise ValueError("Скачанный пакет не соответствует релизу WorkTimer.")
        except Exception as exc:
            self.error(str(exc))
            return
        if not shutil.which("pkexec") or not shutil.which("apt-get"):
            self.error("Обновление скачано. Установите пакет командой:\n\nsudo apt install " + shlex.quote(path), warning=False)
            return
        if not self.confirm_update("Обновление скачано и проверено. Установить версию %s?\nСистема запросит права администратора. После установки таймер перезапустится." % release["version"]):
            return
        self.mi_update.set_label("Устанавливается обновление…")

        def install():
            result = subprocess.run([shutil.which("pkexec"), shutil.which("apt-get"), "install", "-y", path],
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=600)
            if result.returncode:
                raise RuntimeError("Установка отменена или завершилась с ошибкой.\n" + result.stderr[-1500:])
            return True

        def done(_result, error):
            self.mi_update.set_label("Обновить до " + release["version"])
            if error:
                self.error(str(error))
                return
            resume = [p.id for p in self.core.projects if p.run_start is not None]
            self.core.settings["updateResume"] = ",".join(resume)
            save_settings(self.core.settings)
            self.core.pause_all()
            if self.core.save_broken:
                for p in self.core.projects:
                    if p.id in resume:
                        p.run_start = dt.datetime.now()
                self.error("Не удалось сохранить часы. Перезапуск отложен; обновление уже установлено.")
                return
            self.closing = True
            self.window.destroy()
            if self.widget:
                self.widget.destroy()
            os.execv(sys.executable, [sys.executable, "/usr/bin/worktimer", "--updated"])
        self.update_worker(install, done)

    def project_dialog(self, rename=False):
        d = Gtk.Dialog(title="Название работы" if rename else "Новая работа",
                       transient_for=self.window, modal=True)
