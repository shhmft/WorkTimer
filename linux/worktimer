    def delete_project_dialog(self):
        if len(self.core.projects) <= 1:
            self.error("Нельзя удалить последнюю оставшуюся работу.")
            return
        project = self.core.current
        dialog = Gtk.MessageDialog(transient_for=self.window, modal=True,
