class ProjectPicker(Gtk.Window):
    """Rounded, scrollable project list styled like the floating widget."""
    ROW_H, PAD, MAX_ROWS = 32, 8, 6

    def __init__(self, widget):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.owner_widget = widget
        self.projects = list(widget.core.projects)
        self.first = 0
        self.hot = -1
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.POPUP_MENU)
        self.set_app_paintable(True)
        screen = widget.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.rows = min(self.MAX_ROWS, len(self.projects))
        self.resize(widget.WW, self.PAD * 2 + self.rows * self.ROW_H)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.POINTER_MOTION_MASK |
                        Gdk.EventMask.SCROLL_MASK |
                        Gdk.EventMask.KEY_PRESS_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_move)
        self.connect("scroll-event", self.on_scroll)
        self.connect("key-press-event", self.on_key)
        self.connect("focus-out-event", self.on_focus_out)

    def show_picker(self, ev):
        self.show_all()
        screen = self.owner_widget.get_screen()
        wx, wy = self.owner_widget.get_position()
        _, widget_height = self.owner_widget.get_size()
        x, y = wx, wy + widget_height
        monitor = screen.get_monitor_at_point(int(ev.x_root), int(ev.y_root))
        area = screen.get_monitor_workarea(monitor)
        _, height = self.get_size()
        if y + height > area.y + area.height:
            y = wy - height
        x = max(area.x + 4, min(x, area.x + area.width - self.owner_widget.WW - 4))
        y = max(area.y + 4, min(y, area.y + area.height - height - 4))
        self.move(int(x), int(y))
        self.present()
        self.grab_focus()

    def on_draw(self, _w, cr):
        # The list remains readable at every widget transparency setting.
        a = 1.0
        width, height = self.get_size()
        cr.set_operator(1)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(2)
        rounded(cr, 1, 1, width - 2, height - 2, 14)
        cr.set_source_rgba(24 / 255, 28 / 255, 40 / 255, 1.0)
        cr.fill_preserve()
        cr.set_source_rgba(*A1, 0.38 * a)
        cr.set_line_width(1)
        cr.stroke()
        selected = self.owner_widget.core.current
        for row in range(self.rows):
            index = self.first + row
            if index >= len(self.projects):
                break
            y = self.PAD + row * self.ROW_H
            if index == self.hot or self.projects[index] is selected:
                rounded(cr, self.PAD + 1, y + 2, width - 2 * self.PAD - 2,
                        self.ROW_H - 4, 8)
                cr.set_source_rgba(*A1, (0.22 if index == self.hot else 0.14) * a)
                cr.fill()
            if self.projects[index] is selected:
                cr.set_source_rgba(*A2, a)
                cr.arc(self.PAD + 13, y + self.ROW_H / 2, 3, 0, 2 * math.pi)
                cr.fill()
            text(cr, self.projects[index].name, self.PAD + 25, y + 9, 9,
                 A2 if self.projects[index] is selected else TEXT,
                 width=width - self.PAD * 2 - 34, ellipsis=True)
        if len(self.projects) > self.rows:
            track_y, track_h = self.PAD + 3, self.rows * self.ROW_H - 6
            thumb_h = max(18, track_h * self.rows / len(self.projects))
            thumb_y = track_y + (track_h - thumb_h) * self.first / (len(self.projects) - self.rows)
            rounded(cr, width - 5, thumb_y, 2, thumb_h, 1)
            cr.set_source_rgba(*MUTED, 0.55 * a)
            cr.fill()
        return False

    def on_move(self, _w, ev):
        row = int((ev.y - self.PAD) // self.ROW_H)
        hot = self.first + row if self.PAD <= ev.y < self.PAD + self.rows * self.ROW_H and self.first + row < len(self.projects) else -1
        if hot != self.hot:
            self.hot = hot
            self.queue_draw()
        return False

    def on_scroll(self, _w, ev):
        if ev.direction == Gdk.ScrollDirection.DOWN:
            step = 1
        elif ev.direction == Gdk.ScrollDirection.UP:
            step = -1
        else:
            return True
        self.first = max(0, min(len(self.projects) - self.rows, self.first + step))
        self.queue_draw()
        return True

    def on_press(self, _w, ev):
        if ev.button == 1:
            row = int((ev.y - self.PAD) // self.ROW_H)
            index = self.first + row
            if self.PAD <= ev.y < self.PAD + self.rows * self.ROW_H and index < len(self.projects):
                project = self.projects[index]
                self.destroy()
                self.owner_widget.project_picker = None
                self.owner_widget.select_project(project)
                return True
        return True

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.destroy()
            self.owner_widget.project_picker = None
        return True

    def on_focus_out(self, *_):
        GLib.timeout_add(120, self.close_if_inactive)
        return False

    def close_if_inactive(self):
        if not self.get_visible():
            return False
        if not self.is_active():
            self.destroy()
            self.owner_widget.project_picker = None
        return False


class Widget(Gtk.Window):
    WW, WH = 214, 70

    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.app = app
        self.core = app.core
        self.set_default_size(self.WW, self.WH)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.drag = None
        self.project_picker = None

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.POINTER_MOTION_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_move)
        self.connect("button-release-event", self.on_release)

        s = self.core.settings
        try:
            self.move(int(s.get("wx", 60)), int(s.get("wy", 60)))
        except ValueError:
            self.move(60, 60)

    def alpha(self):
        try:
            return max(0.35, min(1.0, float(self.core.settings.get("alpha", 0.92))))
        except ValueError:
            return 0.92

    def on_press(self, _w, ev):
        if ev.button == 3:
            self.app.menu_popup(ev)
            return True
        if ev.button == 1 and ev.x >= self.WW - 30 and ev.y < 23:
            if self.project_picker:
                self.project_picker.destroy()
            self.project_picker = ProjectPicker(self)
            self.project_picker.show_picker(ev)
            return True
        if ev.x >= self.WW - 52 and 18 <= ev.y <= 52:
            self.core.toggle(self.core.current)
            self.app.refresh()
            return True
        self.drag = (ev.x_root, ev.y_root) + tuple(self.get_position())
        return True

    def select_project(self, project):
        self.core.select(project)
        self.app.refresh()

    def on_move(self, _w, ev):
        if self.drag:
            x0, y0, wx, wy = self.drag
            self.move(int(wx + ev.x_root - x0), int(wy + ev.y_root - y0))
        return True

    def on_release(self, *_):
        if self.drag:
            self.drag = None
            x, y = self.get_position()
            self.core.settings["wx"] = str(x)
            self.core.settings["wy"] = str(y)
            save_settings(self.core.settings)
        return True

    def on_draw(self, _w, cr):
        core = self.core
        a = self.alpha()
        running = core.running
        paused = not running and core.session_accum > 0
        acc = GREEN if running else (AMBER if paused else MUTED)

        cr.set_operator(1)  # SOURCE — стираем прошлый кадр вместе с прозрачностью
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(2)  # OVER

        cr.set_source_rgba(24 / 255, 28 / 255, 40 / 255, 0.88 * a)
        rounded(cr, 1, 1, self.WW - 2, self.WH - 2, 18)
        cr.fill_preserve()
        cr.set_source_rgba(*acc, (0.35 if running else 0.18) * a)
        cr.set_line_width(1.4)
        cr.stroke()

        cr.set_source_rgba(*acc, a)
        cr.arc(17, self.WH / 2, 4.5, 0, 2 * math.pi)
        cr.fill()
        cr.move_to(self.WW - 24, 12)
        cr.line_to(self.WW - 20, 16)
        cr.line_to(self.WW - 16, 12)
        cr.set_line_width(1.5)
        cr.stroke()

        cr.push_group()
        text(cr, fmt(core.today()), 31, 11, 17, A2 if running else TEXT, bold=True)
        text(cr, core.widget_caption, 33, 43, 7, MUTED, width=123, ellipsis=True)
        cr.pop_group_to_source()
        cr.paint_with_alpha(a)

        bx, by = self.WW - 35, self.WH / 2
        cr.set_source_rgba(*CARD2, 0.7 * a)
        cr.arc(bx, by, 17, 0, 2 * math.pi)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 0.92 * a)
        if running:
            cr.rectangle(bx - 4.5, by - 6, 3.2, 12)
            cr.rectangle(bx + 1.3, by - 6, 3.2, 12)
            cr.fill()
        else:
            cr.move_to(bx - 4, by - 6.5)
            cr.line_to(bx + 6, by)
            cr.line_to(bx - 4, by + 6.5)
            cr.close_path()
            cr.fill()

        frac = min(1.0, core.today() / 480.0)
        cr.set_source_rgba(90 / 255, 105 / 255, 140 / 255, 0.3 * a)
        rounded(cr, 16, self.WH - 11, self.WW - 32, 3, 1.5)
        cr.fill()
        if frac > 0.005:
            grad(cr, 16, self.WH - 11, self.WW - 32, 3,
                 GREEN if frac >= 1 else A1, A2)
            rounded(cr, 16, self.WH - 11, (self.WW - 32) * frac, 3, 1.5)
            cr.fill()
        return False


